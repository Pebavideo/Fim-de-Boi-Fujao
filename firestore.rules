rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /animais/{animalId} {
      allow read, write: if request.auth != null && request.auth.token.email == resource.data.emailDono;
      allow create: if request.auth != null && request.auth.token.email == request.resource.data.emailDono;
    }
    
    match /itens/{itemId} {
      allow read, write: if request.auth != null && request.auth.token.email == resource.data.emailDono;
      allow create: if request.auth != null && request.auth.token.email == request.resource.data.emailDono;
    }
    
    // Manter a regra para lojistas se precisarmos depois
    match /lojistas/{email} {
      allow read, write: if request.auth.token.email == email;
    }
  }
}